{
    "name": "tyhpdef/league-oauth2-client-impl",
    "description": "Implementation package for tyhpdef/league-oauth2-client. Require tyhpdef/league-oauth2-client, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "2.9.1.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/guzzlehttp-guzzle": "@dev",
                "tyhpdef/guzzlehttp-psr7": "@dev",
                "tyhpdef/psr-http-message": "@dev",
                "tyhpdef/psr-http-client": "@dev",
                "tyhpdef/psr-http-factory": "@dev",
                "tyhpdef/guzzlehttp-promises": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/league-oauth2-client"
        }
    },
    "require": {
        "php": ">=8.2",
        "league/oauth2-client": "2.9.1"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/guzzlehttp-guzzle": "@dev",
        "tyhpdef/guzzlehttp-psr7": "@dev",
        "tyhpdef/psr-http-message": "@dev",
        "tyhpdef/psr-http-client": "@dev",
        "tyhpdef/psr-http-factory": "@dev",
        "tyhpdef/guzzlehttp-promises": "@dev"
    }
}
